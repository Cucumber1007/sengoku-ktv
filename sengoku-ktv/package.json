{
  "name": "sengoku-ktv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-icons.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173",
    "preview:lan:https": "PREVIEW_HTTPS=true vite preview --host 0.0.0.0 --port 4173",
    "setup:https": "node scripts/setup-https-certs.mjs",
    "mobile:test": "npm run build && node scripts/print-network-urls.mjs 4173 http && npm run preview:lan",
    "mobile:test:https": "npm run build && node scripts/print-network-urls.mjs 4173 https && npm run preview:lan",
    "mobile:offline": "npm run setup:https && npm run mobile:test:https"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
